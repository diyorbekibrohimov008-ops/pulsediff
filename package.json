{
  "name": "pulsediff",
  "version": "1.0.0",
  "description": "100% free website and API uptime monitoring with 30-second checks, live response-body diffing, auto-heal webhooks, and white-label status pages.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx server.mjs --dev",
    "build": "vite build",
    "start": "node --import tsx server.mjs",
    "test": "vitest run --pool=threads",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/host-grotesk": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@netlify/blobs": "^8.1.2",
    "@netlify/functions": "^6.1.1",
    "@vercel/blob": "^2.9.0",
    "lucide-react": "^0.554.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "^4.6.7"
    }
  }
}
